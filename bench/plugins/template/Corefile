# about: template answers A queries matching a regex with named groups
# queries: {DIR}/queries.txt
.:{PORT} {
    template IN A example.org {
        match ^ip-(?P<a>[0-9]+)-(?P<b>[0-9]+)\.example\.org\.$
        answer "{{ .Name }} 60 IN A 10.0.{{ .Group.a }}.{{ .Group.b }}"
        fallthrough
    }
    whoami
}
