# about: TSIG-signed UPDATEs (add or delete one A record) to an in-memory dynupdate zone
# queries: {DIR}/updates.txt
# dnsperf: -u -y hmac-sha256:update.key.:i9M+00yrECfVZG2qCjr4mPpaGim/Bq+IWMiNrLjUO4Y=
example.org:{PORT} {
    tsig {
        secret update.key. i9M+00yrECfVZG2qCjr4mPpaGim/Bq+IWMiNrLjUO4Y=
        require_opcode UPDATE
    }
    dynupdate {
        file {FIX}/db.100.example.org
        allow update.key. * A
    }
}
