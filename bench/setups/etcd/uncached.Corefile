# about: the etcd setup without cache: every etcd query reads etcd (in Rust in KernDNS)
# queries: {FIX}/q-etcd.txt
# needs: etcd
.:{PORT} {
    errors
    prometheus 127.0.0.1:0
    etcd skydns.local {
        path /skydns
        endpoint http://127.0.0.1:{ETCD}
    }
    loadbalance
    forward . 127.0.0.1:{BACKEND}
}
