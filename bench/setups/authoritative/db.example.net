$ORIGIN example.net.
$TTL 3600
@               IN SOA   ns1 hostmaster 2026112701 7200 3600 1209600 300
@               IN NS    ns1
@               IN NS    ns2.example.org.
@               IN A     192.0.2.10
@               IN AAAA  2001:db8::10
@               IN MX    10 mx1
@               IN MX    20 mx2
@               IN TXT   "v=spf1 mx -all"
@               IN CAA   0 issue "letsencrypt.org"
ns1             IN A     192.0.2.53
ns1             IN AAAA  2001:db8::53
mx1             IN A     192.0.2.25
mx2             IN A     198.51.100.25
www             IN CNAME @
api             IN A     192.0.2.20
api             IN A     192.0.2.21
api             IN A     192.0.2.22
api             IN AAAA  2001:db8::20
api             IN AAAA  2001:db8::21
cdn             IN CNAME cdn.example.org.
mail            IN CNAME mx1
_dmarc          IN TXT   "v=DMARC1; p=reject; rua=mailto:dmarc@example.net"
_sip._tcp       IN SRV   10 60 5060 sip1
_sip._tcp       IN SRV   10 40 5060 sip2
sip1            IN A     192.0.2.30
sip2            IN A     192.0.2.31
*.apps          IN A     192.0.2.40
dev             IN NS    ns1.dev
ns1.dev         IN A     192.0.2.60
